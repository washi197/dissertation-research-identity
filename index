<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Dissertation Research Identity - Purdue D.Tech</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');
*{box-sizing:border-box;margin:0;padding:0;}
:root{
  --gold:#CFB991;--gold-light:#e8d5a3;--gold-dim:rgba(207,185,145,0.12);
  --gold-border:rgba(207,185,145,0.25);--gold-border-hover:rgba(207,185,145,0.5);
  --bg:#0a0a0a;--card:#111111;--card2:#0d0d0d;
  --text:#f0ece2;--text-sub:#ccc4b4;--text-dim:#9c9080;
}
body{font-family:'Inter',sans-serif;background:var(--bg);color:var(--text);min-height:100vh;}

.hero{background:#111;border-bottom:3px solid var(--gold);padding:1.5rem 2rem;display:flex;align-items:center;gap:1.5rem;}
.logo{border-right:1px solid var(--gold-border);padding-right:1.4rem;flex-shrink:0;}
.logo img,.logo svg{height:38px;width:auto;display:block;}
.hero-t h1{font-size:1.25rem;font-weight:700;color:#fff;}
.hero-t p{font-size:.78rem;color:var(--text-sub);margin-top:.25rem;}

.body{max-width:860px;margin:0 auto;padding:2rem 1.5rem 3rem;}
.section{margin-bottom:2rem;}
.sec-hdr{padding-bottom:.55rem;border-bottom:1px solid rgba(207,185,145,.12);margin-bottom:1rem;}
.sec-title{font-size:.72rem;font-weight:700;color:var(--gold);letter-spacing:.1em;text-transform:uppercase;}

.topic-block{background:var(--card);border:1px solid var(--gold-border-hover);border-radius:12px;padding:1.5rem;margin-bottom:1.25rem;}
.topic-label{font-size:.65rem;font-weight:700;color:var(--gold);letter-spacing:.1em;text-transform:uppercase;margin-bottom:.6rem;}
.topic-title{font-size:1.1rem;font-weight:700;color:var(--gold-light);line-height:1.5;}

.sentence-block{background:rgba(207,185,145,.06);border-left:3px solid var(--gold);border-radius:0 8px 8px 0;padding:1rem 1.25rem;margin-bottom:1.25rem;}
.sentence-label{font-size:.65rem;font-weight:700;color:var(--gold);letter-spacing:.1em;text-transform:uppercase;margin-bottom:.5rem;}
.sentence-text{font-size:.95rem;color:var(--text);line-height:1.8;font-style:italic;}

.bullet-card{background:var(--card);border:1px solid var(--gold-border);border-radius:10px;overflow:hidden;margin-bottom:1rem;}
.bullet-card-hdr{background:rgba(207,185,145,.06);border-bottom:1px solid var(--gold-border);padding:.75rem 1rem;font-size:.72rem;font-weight:700;color:var(--gold);letter-spacing:.09em;text-transform:uppercase;}
.bullet-list{padding:.85rem 1rem;display:flex;flex-direction:column;gap:.65rem;}
.bullet-item{display:flex;align-items:flex-start;gap:.75rem;font-size:.89rem;color:var(--text-sub);line-height:1.65;}
.bullet-dot{width:6px;height:6px;border-radius:50%;background:var(--gold);flex-shrink:0;margin-top:.45rem;}
.bullet-item strong{color:var(--gold-light);}

.two-col{display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-bottom:1rem;}

.table-wrap{background:var(--card);border:1px solid var(--gold-border);border-radius:10px;overflow:hidden;margin-bottom:1rem;}
.table-hdr{background:rgba(207,185,145,.06);border-bottom:1px solid var(--gold-border);padding:.75rem 1rem;font-size:.72rem;font-weight:700;color:var(--gold);letter-spacing:.09em;text-transform:uppercase;}
table{width:100%;border-collapse:collapse;}
thead tr{background:rgba(207,185,145,.04);}
thead th{padding:.65rem 1rem;font-size:.68rem;font-weight:700;color:var(--gold);letter-spacing:.07em;text-transform:uppercase;text-align:left;border-bottom:1px solid var(--gold-border);}
tbody tr{border-bottom:1px solid rgba(207,185,145,.06);}
tbody tr:last-child{border-bottom:none;}
tbody tr:hover{background:rgba(207,185,145,.03);}
tbody td{padding:.7rem 1rem;font-size:.88rem;line-height:1.65;}
tbody td:first-child{color:var(--gold-light);font-weight:600;width:40%;}
tbody td:last-child{color:var(--text-sub);}

.three-circles{display:grid;grid-template-columns:1fr 1fr 1fr;gap:1rem;margin-bottom:1rem;}
.circle-card{background:var(--card);border:1px solid var(--gold-border);border-radius:10px;padding:1rem;text-align:center;}
.circle-num{width:36px;height:36px;border-radius:50%;background:var(--gold);color:#000;font-size:.82rem;font-weight:800;display:flex;align-items:center;justify-content:center;margin:0 auto .65rem;}
.circle-label{font-size:.7rem;font-weight:700;color:var(--gold);letter-spacing:.08em;text-transform:uppercase;margin-bottom:.4rem;}
.circle-text{font-size:.78rem;color:var(--text-sub);line-height:1.6;}

.real-world-card{background:var(--card);border:1px solid var(--gold-border);border-radius:10px;overflow:hidden;margin-bottom:.75rem;}
.rw-hdr{background:rgba(207,185,145,.06);border-bottom:1px solid var(--gold-border);padding:.65rem 1rem;display:flex;align-items:center;gap:.65rem;}
.rw-num{width:22px;height:22px;border-radius:50%;background:var(--gold);color:#000;font-size:.68rem;font-weight:800;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
.rw-title{font-size:.8rem;font-weight:700;color:var(--gold-light);}
.rw-body{padding:.8rem 1rem;font-size:.88rem;color:var(--text-sub);line-height:1.75;}

.sector-grid{display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-bottom:1rem;}
.sector-card{background:var(--card);border:1px solid var(--gold-border);border-radius:10px;overflow:hidden;}
.sector-hdr{background:rgba(207,185,145,.06);border-bottom:1px solid var(--gold-border);padding:.65rem 1rem;font-size:.72rem;font-weight:700;color:var(--gold);letter-spacing:.08em;text-transform:uppercase;}
.sector-list{padding:.8rem 1rem;display:flex;flex-direction:column;gap:.45rem;}
.sector-item{display:flex;align-items:flex-start;gap:.6rem;font-size:.8rem;color:var(--text-sub);line-height:1.55;}
.sector-dot{width:5px;height:5px;border-radius:50%;background:var(--gold);flex-shrink:0;margin-top:.42rem;opacity:.7;}

.applicability-sentence{background:rgba(207,185,145,.06);border-left:3px solid var(--gold);border-radius:0 8px 8px 0;padding:1rem 1.25rem;margin-bottom:1.25rem;}
.applicability-sentence p{font-size:.88rem;color:var(--text);line-height:1.8;font-style:italic;}

.footer{text-align:center;padding:2rem 0 1rem;font-size:.7rem;color:var(--text-dim);}
.footer strong{color:var(--gold);letter-spacing:.06em;text-transform:uppercase;}
.core-arg{background:var(--card);border:1px solid var(--gold-border-hover);border-radius:12px;padding:1.5rem;margin-bottom:2rem;}
.core-arg-label{font-size:.65rem;font-weight:700;color:var(--gold);letter-spacing:.1em;text-transform:uppercase;margin-bottom:.75rem;}
.core-arg-title{font-size:1rem;font-weight:700;color:var(--gold-light);line-height:1.5;margin-bottom:1rem;}
.core-arg-body{font-size:.85rem;color:var(--text-sub);line-height:1.8;}
.core-arg-body p{margin-bottom:.75rem;}
.core-arg-body p:last-child{margin-bottom:0;}
.core-pillars{display:grid;grid-template-columns:1fr 1fr 1fr;gap:.85rem;margin-top:1rem;}
.pillar{display:none;}
.audience-circles{display:grid;grid-template-columns:1fr 1fr 1fr;gap:1rem;margin-top:1.25rem;}
.audience-circle{background:var(--card);border:1px solid var(--gold-border-hover);border-radius:50%;aspect-ratio:1/1;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:1.5rem;position:relative;transition:border-color .2s;}
.audience-circle:hover{border-color:var(--gold);}
.audience-circle-icon{font-size:1.6rem;margin-bottom:.6rem;}
.audience-circle-label{font-size:.7rem;font-weight:700;color:var(--gold);letter-spacing:.08em;text-transform:uppercase;margin-bottom:.5rem;line-height:1.3;}
.audience-circle-text{font-size:.72rem;color:var(--text-sub);line-height:1.55;}
.audience-connector{display:flex;align-items:center;justify-content:center;margin-top:.75rem;gap:.5rem;}
.connector-line{flex:1;height:1px;background:var(--gold-border);}
.connector-label{font-size:.65rem;font-weight:700;color:var(--text-dim);letter-spacing:.08em;text-transform:uppercase;white-space:nowrap;padding:0 .5rem;}
@media(max-width:700px){.core-pillars,.audience-circles{grid-template-columns:1fr;}.audience-circle{aspect-ratio:auto;border-radius:12px;}}

/* ── AI Section Tabs ── */
.tab-bar{display:flex;gap:.5rem;margin-bottom:1rem;flex-wrap:wrap;}
.tab-btn{background:transparent;border:1px solid var(--gold-border);color:var(--text-sub);font-family:'Inter',sans-serif;font-size:.72rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;padding:.45rem .85rem;border-radius:6px;cursor:pointer;transition:all .2s;}
.tab-btn:hover{border-color:var(--gold-border-hover);color:var(--gold);}
.tab-btn.active{background:var(--gold);color:#000;border-color:var(--gold);}
.tab-panel{display:none;}
.tab-panel.active{display:block;}

/* ── Sentiment / Feeling Cards ── */
.sentiment-grid{display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-bottom:1rem;}
.sentiment-card{background:var(--card);border:1px solid var(--gold-border);border-radius:10px;overflow:hidden;}
.sentiment-hdr{padding:.65rem 1rem;font-size:.72rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;}
.sentiment-hdr.pos{background:rgba(100,200,100,.08);color:#7ecb7e;border-bottom:1px solid rgba(100,200,100,.2);}
.sentiment-hdr.neg{background:rgba(220,80,80,.08);color:#e07070;border-bottom:1px solid rgba(220,80,80,.2);}
.sentiment-list{padding:.8rem 1rem;display:flex;flex-direction:column;gap:.45rem;}
.sentiment-item{display:flex;align-items:flex-start;gap:.6rem;font-size:.86rem;color:var(--text-sub);line-height:1.55;}
.s-dot-pos{width:5px;height:5px;border-radius:50%;background:#7ecb7e;flex-shrink:0;margin-top:.42rem;}
.s-dot-neg{width:5px;height:5px;border-radius:50%;background:#e07070;flex-shrink:0;margin-top:.42rem;}

/* ── Usage Examples Grid ── */
.usage-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:.85rem;margin-bottom:1rem;}
.usage-card{background:var(--card);border:1px solid var(--gold-border);border-radius:10px;padding:1rem;}
.usage-icon{font-size:1.4rem;margin-bottom:.5rem;}
.usage-title{font-size:.75rem;font-weight:700;color:var(--gold-light);margin-bottom:.4rem;}
.usage-desc{font-size:.83rem;color:var(--text-sub);line-height:1.6;}

/* ── AI Interaction Pros/Cons ── */
.proscon-grid{display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-bottom:1rem;}
.proscon-card{background:var(--card);border-radius:10px;overflow:hidden;}
.proscon-card.pros{border:1px solid rgba(100,200,100,.3);}
.proscon-card.cons{border:1px solid rgba(220,80,80,.3);}
.proscon-hdr{padding:.75rem 1rem;font-size:.72rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;}
.proscon-card.pros .proscon-hdr{background:rgba(100,200,100,.07);color:#7ecb7e;border-bottom:1px solid rgba(100,200,100,.15);}
.proscon-card.cons .proscon-hdr{background:rgba(220,80,80,.07);color:#e07070;border-bottom:1px solid rgba(220,80,80,.15);}
.proscon-list{padding:.85rem 1rem;display:flex;flex-direction:column;gap:.55rem;}
.proscon-item{display:flex;align-items:flex-start;gap:.65rem;font-size:.86rem;color:var(--text-sub);line-height:1.6;}

/* ── Chapter Draft Cards ── */
.chapter-card{background:var(--card);border:1px solid var(--gold-border);border-radius:12px;overflow:hidden;margin-bottom:1rem;}
.chapter-hdr{background:rgba(207,185,145,.06);border-bottom:1px solid var(--gold-border);padding:.9rem 1.25rem;display:flex;align-items:center;gap:1rem;}
.chapter-num{width:32px;height:32px;border-radius:50%;background:var(--gold);color:#000;font-size:.78rem;font-weight:800;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
.chapter-meta{flex:1;}
.chapter-title{font-size:.92rem;font-weight:700;color:var(--gold-light);line-height:1.4;}
.chapter-sub{font-size:.68rem;color:var(--text-sub);margin-top:.2rem;letter-spacing:.04em;}
.chapter-body{padding:1rem 1.25rem;}
.chapter-purpose{font-size:.88rem;color:var(--text-sub);line-height:1.75;margin-bottom:.85rem;}
.chapter-topics{display:flex;flex-direction:column;gap:.4rem;}
.chapter-topic{display:flex;align-items:flex-start;gap:.65rem;font-size:.85rem;color:var(--text-sub);line-height:1.55;}
.chapter-topic-dot{width:5px;height:5px;border-radius:50%;background:var(--gold);flex-shrink:0;margin-top:.48rem;opacity:.7;}
.chapter-topic strong{color:var(--gold-light);}
.chapter-status-details{margin-top:.9rem;display:inline-block;}
.chapter-status-details summary{font-size:.65rem;font-weight:700;letter-spacing:.09em;text-transform:uppercase;color:var(--text-dim);cursor:pointer;user-select:none;list-style:none;padding:.3rem .65rem;border-radius:4px;border:1px solid rgba(207,185,145,.15);display:inline-flex;align-items:center;gap:.4rem;transition:all .2s;}
.chapter-status-details summary::-webkit-details-marker{display:none;}
.chapter-status-details summary::after{content:"›";font-size:.8rem;transition:transform .2s;}
.chapter-status-details[open] summary::after{transform:rotate(90deg);}
.chapter-status-details summary:hover{border-color:var(--gold-border);color:var(--text-sub);}
.chapter-status-text{display:block;margin-top:.45rem;font-size:.72rem;color:var(--text-sub);font-style:italic;padding:.35rem .65rem;background:rgba(207,185,145,.05);border-radius:4px;border:1px solid var(--gold-border);}


/* ── Call to Action Grid ── */
.cta-grid{display:grid;grid-template-columns:1fr 1fr;gap:.75rem;margin-top:.85rem;}
.cta-item{background:rgba(207,185,145,.06);border:1px solid var(--gold-border);border-radius:8px;padding:.85rem 1rem;}
.cta-label{font-size:.68rem;font-weight:700;color:var(--gold);letter-spacing:.09em;text-transform:uppercase;margin-bottom:.4rem;}
.cta-text{font-size:.85rem;color:var(--text-sub);line-height:1.6;}

/* ── Responsive ── */
@media(max-width:700px){
  .hero{padding:1rem 1.25rem;gap:1rem;}
  .body{padding:1.25rem 1rem 2.5rem;}
  .two-col,.sector-grid,.sentiment-grid,.proscon-grid,.three-circles,.usage-grid,.cta-grid{grid-template-columns:1fr;}
  .hero-t h1{font-size:1.05rem;}
  table{font-size:.75rem;}
  thead th,tbody td{padding:.5rem .75rem;}
}
@media print{
  body{background:#fff;color:#000;}
  .hero{background:#000;}
}
</style>
</head>
